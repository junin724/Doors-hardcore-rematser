function LoadCustomInstance(assetId, parent)
    local model

    while task.wait() and not model do
        print("🔄 Trying to load model with Asset ID: " .. tostring(assetId))

        local success, result = pcall(function()
            return game:GetObjects("rbxassetid://" .. assetId)[1]
        end)

        if success and result then
            model = result
            model.Parent = parent or workspace

            for _, obj in ipairs(model:GetDescendants()) do
                if obj:IsA("Script") or obj:IsA("LocalScript") then
                    obj:Destroy()
                end
            end

            pcall(function()
                model:SetAttribute("LoadedByExecutor", true)
            end)

            print("✅ [LoadCustomInstance]: Model " .. model.Name .. " successfully loaded into " .. model.Parent:GetFullName())
        else
            print("❌ [LoadCustomInstance]: Failed to load model ID " .. tostring(assetId) .. ". Retrying... 🔄")
            task.wait(0.5)
        end
    end

    return model
end

function Move()
    local s = LoadCustomInstance("12254145022", workspace)
    if not s then return end
    s.Parent = workspace

    local val = 60
    local killed = false
    local entity = s:FindFirstChild("Rebound") or s:FindFirstChildWhichIsA("BasePart") or s

    if not entity then
        warn("[Rebound] Entity part not found in model. Aborting.")
        return
    end

    print("[Rebound] Entity found: Hello World!")

    local function GetLastRoom()
        local gruh = workspace.CurrentRooms
        return gruh[game.ReplicatedStorage.GameData.LatestRoom.Value + 1]
    end

    local lastRoom = GetLastRoom()
    if lastRoom and lastRoom:FindFirstChild("RoomExit") then
        if entity:IsA("Model") then
            entity:PivotTo(lastRoom.RoomExit.CFrame)
        else
            entity.CFrame = lastRoom.RoomExit.CFrame
        end
    end

    local function canSeeTarget(target, size)
        if killed then return false end
        local origin = entity:IsA("Model") and entity.PrimaryPart and entity.PrimaryPart.Position or entity.Position
        local direction = (target.HumanoidRootPart.Position - origin).unit * size
        local ray = Ray.new(origin, direction)
        local hit = workspace:FindPartOnRay(ray, entity)
        if hit and hit:IsDescendantOf(target) then
            killed = true
            return true
        end
        return false
    end

    local customPreSound = Instance.new("Sound")
    customPreSound.Name = "ReboundCustomPre"
    customPreSound.Volume = 3
    customPreSound.RollOffMinDistance = 5
    customPreSound.RollOffMaxDistance = 1000
    customPreSound.Parent = entity

    local distortion = Instance.new("DistortionSoundEffect")
    distortion.Level = 0.5
    distortion.Parent = customPreSound

    task.spawn(function()
        customPreSound.SoundId = GitAud("https://github.com/junin724/Custom-Sounds/raw/refs/heads/main/ReboundComing.mp3.mpeg%20%281%29.mp3", "ReboundCustomPre")
    end)

    task.wait(3.5)

    local preMoveSound = Instance.new("Sound")
    preMoveSound.Name = "PreMoveSound"
    preMoveSound.SoundId = "rbxassetid://9114221327"
    preMoveSound.Volume = 2
    preMoveSound.Parent = workspace
    preMoveSound:Play()
    game.Debris:AddItem(preMoveSound, 3)

    if customPreSound.SoundId ~= "" then
        customPreSound:Play()
    end
    game.Debris:AddItem(customPreSound, 12)

    task.wait(0.5)

    task.spawn(function()
        while entity and entity.Parent do 
            task.wait(0.5)
            local v = game.Players.LocalPlayer
            if v.Character and v.Character:FindFirstChild("HumanoidRootPart") and not v.Character:GetAttribute("Hiding") then
                if canSeeTarget(v.Character, 50) then
                    local ReboundJs = Instance.new("ScreenGui")
                    local Static = Instance.new("ImageLabel")
                    local Rebound = Instance.new("ImageLabel")
                    local JSSIZE = Instance.new("ImageLabel")

                    ReboundJs.Name = "ReboundJs"
                    ReboundJs.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

                    Static.Name = "Static"
                    Static.Parent = ReboundJs
                    Static.BackgroundTransparency = 1
                    Static.Size = UDim2.new(11, 0, 111, 0)
                    Static.Image = "rbxassetid://236543215"
                    Static.ImageTransparency = 1

                    Rebound.Name = "Rebound"
                    Rebound.Parent = ReboundJs
                    Rebound.BackgroundTransparency = 1
                    Rebound.Position = UDim2.new(0.4866, 0, 0.4793, 0)
                    Rebound.Size = UDim2.new(0.0267, 0, 0.0387, 0)
                    Rebound.Image = "rbxassetid://10914800940"

                    JSSIZE.Name = "JSSIZE"
                    JSSIZE.Parent = ReboundJs
                    JSSIZE.BackgroundTransparency = 1
                    JSSIZE.Position = UDim2.new(-0.586, 0, -1.251, 0)
                    JSSIZE.Size = UDim2.new(2.128, 0, 3.081, 0)
                    JSSIZE.Visible = false
                    JSSIZE.Image = "rbxassetid://10914800940"

                    coroutine.wrap(function()
                        local script = Static
                        while ReboundJs and ReboundJs.Parent do
                            script.Image = "rbxassetid://236543215"
                            task.wait(0.002)
                            script.Rotation = 0
                            task.wait(0.002)
                            script.Rotation = 180
                            task.wait(0.002)
                            script.Image = "rbxassetid://236777652"
                            task.wait(0.002)
                            script.Rotation = 0
                            task.wait(0.002)
                            script.Rotation = 180
                            task.wait(0.002)
                        end
                    end)()

                    coroutine.wrap(function()
                        local Plr = game.Players.LocalPlayer
                        local gui = ReboundJs
                        local static = gui.Static
                        local jspos = gui.JSSIZE

                        local jsSound = Instance.new("Sound")
                        jsSound.Name = "ReboundJumpscareSound"
                        jsSound.SoundId = "rbxassetid://109582246349306"
                        jsSound.Volume = 1.25
                        jsSound.TimePosition = 0.1
                        jsSound.Parent = workspace
                        jsSound:Play()
                        game.Debris:AddItem(jsSound, 5)

                        game.TweenService:Create(static, TweenInfo.new(0.5), {ImageTransparency = 0.8}):Play()
                        game.TweenService:Create(gui.Rebound, TweenInfo.new(0.5), {Size = jspos.Size, Position = jspos.Position}):Play()
                        
                        task.spawn(function()
                            task.wait(0.3)
                            if Plr.Character and Plr.Character:FindFirstChildWhichIsA("Humanoid") then
                                Plr.Character:FindFirstChildWhichIsA("Humanoid"):TakeDamage(100)
                            end
                            if game.ReplicatedStorage:FindFirstChild("GameStats") and game.ReplicatedStorage.GameStats:FindFirstChild("Player_" .. Plr.Name) then
                                game.ReplicatedStorage.GameStats["Player_" .. Plr.Name].Total.DeathCause.Value = "Rebound"
                            end
                            if game.ReplicatedStorage:FindFirstChild("Bricks") and game.ReplicatedStorage.Bricks:FindFirstChild("DeathHint") then
                                game.ReplicatedStorage.Bricks.DeathHint.OnClientEvent:Fire({
                                    "You died to who you call Rebound...",
                                    "He makes his presence known and keeps coming back...",
                                    "Hide when this happens!"
                                })
                            end
                        end)
                        
                        task.wait(0.5)
                        game.TweenService:Create(static, TweenInfo.new(1), {ImageTransparency = 1}):Play()
                        game.TweenService:Create(gui.Rebound, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()
                        task.wait(1)
                        gui:Destroy()
                    end)()
                end
            end
            
            local entPos = entity:IsA("Model") and entity.PrimaryPart and entity.PrimaryPart.Position or entity.Position
            if v.Character and v.Character:FindFirstChild("HumanoidRootPart") and entPos then
                if (entPos - v.Character.HumanoidRootPart.Position).Magnitude <= val then
                    camShake:Start()
                    camShake:ShakeOnce(17, 6, 0.1, 1)
                end
            end
        end
    end)

    local gruh = workspace.CurrentRooms
    for i = game.ReplicatedStorage.GameData.LatestRoom.Value, 1, -1 do
        if gruh:FindFirstChild(i) then
            local room = gruh[i]
            if room:FindFirstChild("RoomEntrance") then
                local a = room.RoomEntrance
                local targetCFrame = a.CFrame
                local tween
                
                if entity:IsA("Model") then
                    tween = game.TweenService:Create(entity.PrimaryPart or entity:FindFirstChildWhichIsA("BasePart"), TweenInfo.new(2, Enum.EasingStyle.Sine), {CFrame = targetCFrame})
                else
                    tween = game.TweenService:Create(entity, TweenInfo.new(2, Enum.EasingStyle.Sine), {CFrame = targetCFrame})
                end
                
                if tween then
                    tween:Play()
                    tween.Completed:Wait()
                end
            end
        end
    end

    if entity:IsA("BasePart") then
        entity.Anchored = false
        entity.CanCollide = false
    end
    game.Debris:AddItem(s, 5)
end

function Rebound()
    local Warn = Instance.new("ColorCorrectionEffect", game.Lighting)
    Warn.Name = "Warn"
    Warn.TintColor = Color3.fromRGB(65, 138, 255)
    Warn.Saturation = -0.7
    Warn.Contrast = 0.2
    game.Debris:AddItem(Warn, 24)

    game.TweenService:Create(Warn, TweenInfo.new(15), {
        TintColor = Color3.fromRGB(255, 255, 255),
        Saturation = 0,
        Contrast = 0
    }):Play()

    camShake:Start()
    camShake:ShakeOnce(10, 3, 0.1, 6, 2, 0.5)
    pcall(Move)

    while maxRebounds > 0 do
        game.ReplicatedStorage.GameData.LatestRoom.Changed:Wait()
        task.wait(2)
        pcall(Move)
        maxRebounds = maxRebounds - 1
    end

    task.wait(15.3)
    if Warn then Warn:Destroy() end
end

pcall(Rebound)
