---====== Load spawner ======---

local spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"))()

---====== Create entity ======---

local entity = spawner.Create({
	Entity = {
		Name = "Deer God",
		Asset = "rbxassetid://12262883448",
		HeightOffset = 0
	},
	Lights = {
		Flicker = {
			Enabled = true,
			Duration = 69
		},
		Shatter = true,
		Repair = false
	},
	Earthquake = {
		Enabled = false
	},
	CameraShake = {
		Enabled = true,
		Range = 100,
		Values = {3.5, 45, 0.1, 2} -- Magnitude, Roughness, FadeIn, FadeOut
	},
	Movement = {
		Speed = 30,
		Delay = 2,
		Reversed = false
	},
    Rebounding = {
        Enabled = false
    },
	Damage = {
		Enabled = true,
		Range = 30,
		Amount = 125
	},
	Crucifixion = {
		Enabled = true,
		Range = 40,
		Resist = false,
		Break = true
	},
	Death = {
		Type = "Guiding", -- "Curious"
		Hints = {"You Died To Deer God", "Dont look at him.", "I hope you follow the guide.", "Remember it all!"},
		Cause = "Deer God"
	}
})

---====== Debug entity ======---

local spawnSound

entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")

    -- Som ao spawnar tocando na velocidade 0.2, volume 3 e persistindo até o entity sumir
    spawnSound = Instance.new("Sound")
    spawnSound.SoundId = "rbxassetid://82890415629830"
    spawnSound.PlaybackSpeed = 0.2
    spawnSound.Volume = 3
    spawnSound.Parent = workspace
    spawnSound:Play()
end)

entity:SetCallback("OnStartMoving", function()
    print("Entity has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
    if firstTime == true then
        print("Entity has entered room: ".. room.Name.. " for the first time")
    else
        print("Entity has entered room: ".. room.Name.. " again")
    end
end)

entity:SetCallback("OnLookAt", function(lineOfSight)
	if lineOfSight == true then
		print("Player is looking at entity")
	else
		print("Player view is obstructed by something")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound)
    if startOfRebound == true then
        print("Entity has started rebounding")
	else
        print("Entity has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
    print("Entity is despawning")
end)

entity:SetCallback("OnDespawned", function()
    print("Entity has despawned")

    -- Para o som de spawn quando ele despawna
    if spawnSound then
        spawnSound:Stop()
        spawnSound:Destroy()
        spawnSound = nil
    end
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
	if newHealth == 0 then
		print("Entity has killed the player")

		-- Som de Jumpscare (Volume 0.7)
		local jumpscareSound = Instance.new("Sound")
		jumpscareSound.SoundId = "rbxassetid://127106124599886"
		jumpscareSound.Volume = 0.7
		jumpscareSound.Parent = workspace
		jumpscareSound:Play()
		game:GetService("Debris"):AddItem(jumpscareSound, 5)

		-- Efeito de tela piscando sem transparência
		task.spawn(function()
			local gui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
			local screengui = Instance.new("ScreenGui")
			screengui.Name = "DeerGodJumpscareFlash"
			screengui.IgnoreGuiInset = true
			screengui.Parent = gui
			
			local frame = Instance.new("Frame")
			frame.Size = UDim2.new(1, 0, 1, 0)
			frame.BorderSizePixel = 0
			frame.BackgroundTransparency = 0
			frame.Parent = screengui
			
			local startTime = tick()
			while tick() - startTime < 2 do
				frame.BackgroundTransparency = 0
				frame.BackgroundColor3 = Color3.fromRGB(45, 0, 65) -- Roxo escuro nitidamente visível
				task.wait(0.1)
				frame.BackgroundTransparency = 0
				frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Preto puro
				task.wait(0.1)
			end
			
			screengui:Destroy()
		end)
	else
		print("Entity has damaged the player")
	end
end)

